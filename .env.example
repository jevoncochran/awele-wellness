# Stripe API keys (test mode — get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Only needed to test the webhook route locally.
# Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` to get this value.
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (order confirmation emails — get an API key from https://resend.com/api-keys)
RESEND_API_KEY=re_...
# Defaults to Resend's shared sandbox sender, which only reliably delivers to
# your own Resend account email. Verify a real domain in Resend and switch
# this to something like "Awele Wellness <orders@awelewellness.com>" before
# relying on this for real customers.
RESEND_FROM_EMAIL=Awele Wellness <onboarding@resend.dev>
# Where the owner is emailed a copy of every paid order (customer info, items,
# quantities, total). With the sandbox sender above this must be your own
# Resend account email until a domain is verified.
ORDER_NOTIFICATION_EMAIL=owner@example.com

# Upstash Redis (stock quantities and sold-out flags). Create a free database
# via the Vercel Marketplace (Storage -> Upstash Redis) or at upstash.com.
# The Vercel integration may inject KV_REST_API_URL / KV_REST_API_TOKEN
# instead; the code accepts either pair of names.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Private admin page (/admin) for managing stock.
# ADMIN_PASSWORD is what the owner types to log in. Use a different one for
# production than for local development.
ADMIN_PASSWORD=choose-a-strong-password
# Signs the login cookie so it can't be forged. Must be a long random string
# (32+ characters). Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=...
