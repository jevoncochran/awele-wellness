# Stripe API keys (test mode — get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Only needed to test the webhook route locally.
# Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` to get this value.
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (order confirmation emails — get an API key from https://resend.com/api-keys)
RESEND_API_KEY=re_...
# Defaults to Resend's shared sandbox sender, which only reliably delivers to
# your own Resend account email. Verify a real domain in Resend and switch
# this to something like "Awele Wellness <orders@awelewellness.com>" before
# relying on this for real customers.
RESEND_FROM_EMAIL=Awele Wellness <onboarding@resend.dev>
